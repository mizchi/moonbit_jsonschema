// typealias @jsonschema.

///|
fn render_enumerable(
  enum_name : String,
  enumerable : Array[@jsonschema.Enumerable],
  prefix~ : String,
  resolver~ : @jsonschema.Resolver,
  pointer~ : JsonPointer,
) -> String {
  let logger = StringBuilder::new()
  logger..write_string(prefix).write_string("enum \{enum_name} {")
  for subschema in enumerable {
    // Tag
    let has_args = subschema.positionals is Some(_) ||
      subschema.params is Some(_)
    if !has_args {
      logger.write_string("\n  \{subschema.tag}")
      continue
    }
    // Tag(
    logger.write_string("\n  \{subschema.tag}(")
    if subschema.positionals is Some(positionals) && positionals.length() > 0 {
      for s in positionals {
        let subtype_code = generate_type_expr(
          s,
          resolver~,
          pointer=pointer.key(subschema.tag).index(0),
        )
        logger.write_string(subtype_code)
      }
    }

    // Tag(A, ~param: V,
    if subschema.params is Some(params) {
      let codes = params.map(fn(key, prop_schema) {
        let subtype_code = generate_type_expr(
          prop_schema,
          resolver~,
          pointer=pointer.key(key),
        )
        "~\{key}: \{subtype_code}"
      })
      logger.write_string(codes.values().to_array().join(", "))
    }
    logger.write_string(")")
  }
  logger.write_string("\n} derive(Debug, Eq, FromJson, ToJson)\n")
  logger.to_string()
}

///|
test "Parse [tagKey, {...}] for moonbit enum" {
  let raw : Json = {
    "definitions": { "Num": { "type": "integer" } },
    "oneOf": [
      // A(~a: Double, ~b: String)
      {
        "type": "array",
        "prefixItems": [
          { "const": "A" },
          {
            "type": "object",
            "required": ["a", "b"],
            "properties": {
              "a": { "type": "number" },
              "b": { "type": "string" },
            },
          },
        ],
      },
      // B
      { "type": "array", "prefixItems": [{ "const": "B" }] },
      // C
      { "type": "array", "prefixItems": [{ "const": "C" }] },
      // X(Num)
      {
        "type": "array",
        "prefixItems": [{ "const": "X" }, { "$ref": "#/definitions/Num" }],
      },
      // Single
      { "const": "Single" },
    ],
  }
  // let schema : JsonSchema = @json.from_json(raw)
  let code = generate(
    raw,
    [JsonPointer::Root],
    root_name="MyEnum",
    prefix="pub ",
  )
  debug_inspect(
    // code,
    code.unwrap(),
    content=(
      #|"// Generated by jsonschema\n\n// #\npub enum MyEnum {\n  A(~a: Double, ~b: String)\n  B\n  C\n  X(Num)\n  Single\n} derive(Debug, Eq, FromJson, ToJson)\n\n// #/definitions/Num\npub struct Num(Int) derive(Eq, Debug, FromJson, ToJson)"
    ),
  )
}

///|
test "all refs in oneOf to enum union types" {
  let raw : Json = {
    "definitions": {
      "A": { "type": "object", "properties": { "a": { "type": "number" } } },
      "B": { "type": "object", "properties": { "b": { "type": "string" } } },
    },
    "oneOf": [
      {
        "type": "array",
        "prefixItems": [{ "const": "A" }, { "$ref": "#/definitions/A" }],
      },
      {
        "type": "array",
        "prefixItems": [{ "const": "B" }, { "$ref": "#/definitions/B" }],
      },
    ],
  }
  // let schema : JsonSchema = @json.from_json(raw)
  let code = generate(
    raw,
    [JsonPointer::Root],
    root_name="MyEnum",
    prefix="pub ",
  )
  debug_inspect(
    // code,
    code.unwrap(),
    content=(
      #|"// Generated by jsonschema\n\n// #\npub enum MyEnum {\n  A(A)\n  B(B)\n} derive(Debug, Eq, FromJson, ToJson)\n\n// #/definitions/A\npub struct A {\n  a: Double?\n} derive(Eq, Debug, FromJson, ToJson)\n\n// #/definitions/B\npub struct B {\n  b: String?\n} derive(Eq, Debug, FromJson, ToJson)\n"
    ),
  )
}
